_pct_color() { # severity color for a percentage: >90 red, >75 yellow, else green
    if (( $1 > 90 )); then printf '\e[31m'; elif (( $1 > 75 )); then printf '\e[33m'; else printf '\e[32m'; fi
}
cwdquota() {
    local fstype pool mnt q=n/a
    read -r _ fstype _ _ _ pool mnt < <(df -PT -- "${1:-.}" 2>/dev/null | tail -1)
    [[ $mnt ]] || { echo "cwdquota: no mount for ${1:-.}" >&2; return 1; }
    if [[ $fstype == nfs* ]] && command -v quota &>/dev/null; then
        # last line: blocks(KiB, '*' if over) quota limit ...; soft limit, else hard
        q=$(quota -v --hide-device -f "$mnt" 2>/dev/null | tail -1 | awk '
            function h(k) { return k >= 2^30 ? sprintf("%.2fT", k/2^30) : sprintf("%.1fG", k/2^20) }
            { sub(/\*/, "", $1); lim = ($2+0 > 0 ? $2 : $3)
              if (lim+0 > 0) printf "%d %s/%s", 100*$1/lim, h($1), h(lim) }')
    fi
    printf '%s  ' "$mnt"
    if [[ $q != n/a && $q ]]; then
        printf 'quota %s%s%%\e[0m (%s)  ' "$(_pct_color "${q%% *}")" "${q%% *}" "${q#* }"
    else
        printf 'quota n/a  '
    fi
    printf 'pool %s%s\e[0m\n' "$(_pct_color "${pool%\%}")" "$pool"
}

# slurm job history (sacct). Top-level jobs only, workdir trimmed to its last
# 3 dirs. RUNNING/PENDING rows squeue doesn't know are stale accounting records
# (runaway jobs) and are dropped. This cluster's sacct refuses windows > 7 days.
_sacct_rows() {
    local live; live=" $(squeue -h -u "$USER" -o %i 2>/dev/null | tr '\n' ' ') "
    sacct -u "$USER" -X --format=JobID%-12,JobName%30,State%-11,Start,Elapsed,WorkDir%-200 "$@" \
        | awk -v live="$live" '{ sub(/ +$/, "") }
            NR == 1 { w = length($0) } NR == 2 { $0 = substr($0, 1, w) }
            NR > 2 && $3 ~ /^(RUNNING|PENDING)/ && !index(live, " " $1 " ") { next }
            { print }' \
        | sed 's|/[^ ]*/\([^/]*/[^/]*/[^/]*\)$|.../\1|'
}
jlast() { # jlast [N]: last N (default 10) jobs from the past 2 days
    _sacct_rows -S now-2days | awk -v n="${1:-10}" 'NR <= 2 { print; next }
        { r[++k] = $0 } END { for (i = (k > n ? k - n + 1 : 1); i <= k; i++) print r[i] }'
}
jf() { # jf [days]: failed/timed-out/OOM/node-failed jobs, default past 2 days
    _sacct_rows -S "now-${1:-2}days" -E now --state=FAILED,TIMEOUT,OUT_OF_MEMORY,NODE_FAIL
}
jweek() { _sacct_rows -S now-7days; } # all jobs, past 7 days (the max window)
swhich() { # swhich -j N: full forensics (submit line, reason, node, workdir)
    sacct -X -o jobid%15,jobname%30,partition%15,submit,start,end,elapsed,state%15,nodelist%25,reason%20,workdir%200,submitline%400 "$@" \
        | less -SX
}
# jwatch [-i secs] JOBID...: block until every job has left the queue, then
# succeed only if all ended COMPLETED, so `jwatch N && next` chains on success.
# Polls every JWATCH_INTERVAL (default 30) secs; state changes go to stderr. A
# squeue error other than "Invalid job id" (purged = done) is retried, never
# read as finished.
jwatch() {
    local iv=${JWATCH_INTERVAL:-30} id out qrc st fail=0
    [[ $1 == -i ]] && { iv=$2; shift 2; }
    (( $# )) || { echo "usage: jwatch [-i secs] JOBID..." >&2; return 2; }
    local -a ids=("$@") left
    local -A seen=()
    local term='^(COMPLETED|CANCELLED|FAILED|TIMEOUT|OUT_OF_MEMORY|NODE_FAIL|PREEMPTED|BOOT_FAIL|DEADLINE)$'
    # a mistyped id must not "succeed": it has to exist and be yours
    local owner
    for id in "${ids[@]}"; do
        owner=$(squeue -h -j "$id" -o %u 2>/dev/null | head -1)
        [[ $owner ]] || owner=$(sacct -j "$id" -X -n -o User%30 2>/dev/null | awk 'NF { print $1; exit }')
        [[ $owner ]] || { echo "jwatch: no job $id on this cluster (SLURM_CONF=${SLURM_CONF-})" >&2; return 2; }
        [[ $owner == "$USER" ]] || { echo "jwatch: job $id belongs to $owner, not you" >&2; return 2; }
    done
    while (( ${#ids[@]} )); do
        left=()
        for id in "${ids[@]}"; do
            out=$(squeue -h -j "$id" -o %T 2>&1); qrc=$?
            if [[ $out == *"Invalid job id"* ]]; then
                continue                    # purged from the queue: done
            elif (( qrc )); then
                st="squeue error: ${out%%$'\n'*}"; left+=("$id")
            elif grep -qvE "$term" <<< "$out" && [[ $out ]]; then
                st=$(sort -u <<< "$out" | paste -sd,); left+=("$id")
            else
                continue                    # only terminal states left: done
            fi
            [[ ${seen[$id]-} == "$st" ]] || printf '[%(%T)T] %s %s\n' -1 "$id" "$st" >&2
            seen[$id]=$st
        done
        ids=("${left[@]}")
        (( ${#ids[@]} )) && sleep "$iv"
    done
    # final verdict from accounting (can lag the queue by a few secs)
    for id in "$@"; do
        local i=0
        until out=$(sacct -j "$id" -X -n -o State%30 2>/dev/null | awk 'NF { $1 = $1; print }'); [[ $out ]] || (( ++i > 5 )); do
            sleep 2
        done
        printf '[%(%T)T] %s finished: %s\n' -1 "$id" "$(paste -sd, <<< "${out:-unknown}")" >&2
        [[ $out ]] && ! grep -qv '^COMPLETED$' <<< "$out" || fail=1
    done
    return "$fail"
}

# git
function git_busy() {
    local d
    d=$(git rev-parse --git-dir 2>/dev/null) || return 1
    if [ -d "$d/rebase-apply" ] && [ -f "$d/rebase-apply/applying" ]; then
        echo "am in progress: git am --continue|--skip|--abort"
    elif [ -d "$d/rebase-merge" ] || [ -d "$d/rebase-apply" ]; then
        echo "rebase in progress: git rebase --continue|--skip|--abort"
    elif [ -f "$d/MERGE_HEAD" ]; then
        echo "merge in progress: git merge --continue|--abort"
    elif [ -f "$d/CHERRY_PICK_HEAD" ]; then
        echo "cherry-pick in progress: git cherry-pick --continue|--skip|--abort"
    elif [ -f "$d/REVERT_HEAD" ]; then
        echo "revert in progress: git revert --continue|--skip|--abort"
    elif [ -f "$d/BISECT_LOG" ]; then
        echo "bisect in progress: git bisect reset"
    else
        return 1
    fi
}
alias gs="git status"
alias gss="git show"
alias gb="git branch"
alias ga="git add"
alias gaa="git add ."
alias gcm="git commit -m"
unalias gco gp gl 2>/dev/null
function gco() {
    # allow file checkouts (conflict resolution) mid-operation
    [[ " $* " =~ \ (--|--ours|--theirs)\  ]] || { git_busy >&2 && return 1; }
    git checkout "$@"
}
function gp() { git_busy >&2 && return 1; git push "$@"; }
function gl() { git_busy >&2 && return 1; git pull "$@"; }
alias gca="git commit --amend"
alias gcan="git commit --amend --no-edit"
alias gbc="GIT_EDITOR=true git rebase --continue"
alias gba="git rebase --abort"
alias gyc="git cherry-pick --continue --no-edit"
alias gys="git cherry-pick --skip"
alias gya="git cherry-pick --abort"
alias gf="git fetch"
alias gd="git diff"
alias gr="grup -R --no-thin"    # todo rm no-thin
alias gry="grup -R -y"
alias gryr="gry && review-since-tag"
alias grx="git review -x"
function _numwrap() {
    local -a a=(); local x
    for x in "$@"; do
        [[ $x =~ ^[0-9]+$ ]] && x=-$x
        a+=("$x")
    done
    command "${a[@]}"
}
function gll() { _numwrap git log "$@"; }
function glo() { _numwrap git log --oneline "$@"; }
# glast [N] file: last N (default 1) commits touching file; glastsrv: same on the
# upstream branch after a quiet fetch (worktree untouched)
_glast_fmt='--format=%h %an %ad %s'
function glast() {
    local n=1; [[ $1 =~ ^[0-9]+$ && $# -gt 1 ]] && { n=$1; shift; }
    git log -"$n" --date=short "$_glast_fmt" -- "$@"
}
function glastr() {
    local n=1 up; [[ $1 =~ ^[0-9]+$ && $# -gt 1 ]] && { n=$1; shift; }
    up=$(git rev-parse --abbrev-ref '@{u}' 2>/dev/null) || up=origin/HEAD
    git fetch -q 2>/dev/null || echo "glastr: fetch failed, showing cached $up" >&2
    git log -"$n" --date=short "$_glast_fmt" "$up" -- "$@"
}

