# sensible defaults + interactive improvements
alias rm="rm -rv"           # recursive, verbose
alias cp="cp -rivL"         # recursive, interactive (confirm overwrite), verbose, follow symlinks
alias cpf="yes | cp -rL"    # recursive, follow symlinks, no confirmation
alias mkdir="mkdir -vp"     # verbose, create parents as needed
alias rmdir="rmdir -pv"     # remove empty parent dirs, verbose
alias df="df -h"            # human-readable sizes
alias du="du -h"            # human-readable sizes
alias free="free -m"        # sizes in MB
touch() {
    mkdir -p "$(dirname "$1")" && command touch "$1"
}
mv() {
    # interactive (confirm overwrite), verbose + missing-dest/dotfile/rmdir prompts
    local -a _args=()
    local _a _target="" _skipnext=0 _endopts=0
    for _a in "$@"; do
        if (( _skipnext )); then _target="$_a"; _skipnext=0; continue; fi
        if (( _endopts )); then _args+=("$_a"); continue; fi
        case "$_a" in
            --) _endopts=1 ;;
            -t|--target-directory) _skipnext=1 ;;
            --target-directory=*) _target="${_a#*=}" ;;
            -*) ;;                       # other option: ignore
            *) _args+=("$_a") ;;
        esac
    done
    local _dest _need
    if [[ -n "$_target" ]]; then
        _dest="$_target"; _need=dir      # -t always names a directory
    elif (( ${#_args[@]} >= 2 )); then
        _dest="${_args[-1]}"
        # >1 source, or trailing slash => dest must be an existing directory
        if (( ${#_args[@]} > 2 )) || [[ "$_dest" == */ ]]; then _need=dir; else _need=parent; fi
    fi
    # ensure destination exists, prompting creation if missing
    if [[ -n "${_need:-}" ]]; then
        local _mk
        if [[ "$_need" == dir ]]; then _mk="${_dest%/}"; else _mk="$(dirname -- "$_dest")"; fi
        if [[ ! -d "$_mk" ]]; then
            if [[ -e "$_mk" ]]; then
                echo "mv: '$_mk' exists but is not a directory" >&2
                return 1
            fi
            read -rp "Destination '$_mk' doesn't exist. Create it? [Y/n] " ans
            [[ -z "$ans" || "$ans" =~ ^[Yy]$ ]] || return 1
            command mkdir -pv -- "$_mk" || return 1
        fi
    fi
    command mv -iv "$@"
    # detect 'mv dir/* ...' pattern: look at the first source's dir (options
    # skipped via _args; needs a known dest, i.e. -t or >=2 operands)
    [[ -n "${_dest:-}" ]] || return
    local src="${_args[0]}"
    local dir
    dir="$(dirname "$src" 2>/dev/null)"
    [[ -z "$dir" || "$dir" == "." || ! -d "$dir" ]] && return
    # check for leftover dotfiles
    local dots
    dots=( "$dir"/.!(.|) )
    if [[ -e "${dots[0]}" ]]; then
        echo "Dotfiles remain in $dir:"
        printf '  %s\n' "${dots[@]##*/}"
        read -rp "Move these too? [y/N] " ans
        if [[ "$ans" =~ ^[Yy]$ ]]; then
            command mv -iv "${dots[@]}" "$_dest"
        fi
    fi
    # prompt to remove dir if now empty
    if [[ -d "$dir" ]] && [[ -z "$(ls -A "$dir")" ]]; then
        read -rp "$dir is empty. Remove it? [y/N] " ans
        [[ "$ans" =~ ^[Yy]$ ]] && rmdir "$dir"
    fi
}

