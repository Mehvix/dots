# sensible defaults + interactive improvements
alias rm="rm -rv"           # recursive, verbose
alias cp="cp -rivL"         # recursive, interactive (confirm overwrite), verbose, follow symlinks
alias cpf="yes | cp -rL"    # recursive, follow symlinks, no confirmation
alias mkdir="mkdir -vp"     # verbose, create parents as needed
alias rmdir="rmdir -pv"     # remove empty parent dirs, verbose
