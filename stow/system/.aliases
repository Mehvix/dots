tf() { # stream file tail
    local n=10
    if [[ "$1" =~ ^[0-9]+$ ]] && [[ $# -gt 1 ]]; then
        n="$1"
        shift
    fi
    tail -n "$n" -f -- "$@"
}
ft() { # file info in rows: size (human), created, modified
	local f
	for f in "$@"; do
		printf 'size:     '
		numfmt --to=iec "$(stat -c %s "$f")" || continue
		stat --printf='created:  %w\nmodified: %y\n' "$f"
	done
}

