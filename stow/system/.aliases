function mkcd() {
    # shellcheck disable=SC2164
    command mkdir -p "$1" && cd "$1"
}
function mkcdtmp() {
    cd "$(mktemp -d /tmp/tmp.XXXXXXXXXX)" || return
}
vsplit() { # vsplit PATH: a var's value one entry per line (split on : or space)
    [[ $1 ]] || { echo "usage: vsplit VARNAME" >&2; return 1; }
    [[ ${!1-} ]] || { echo "vsplit: \$$1 is empty or unset" >&2; return 1; }
    tr ':[:space:]' '\n' <<< "${!1}" | sed '/^$/d'
}
prange() { # prange N M file: lines N-M, quits at M so huge logs are fast
    sed -n "${1},${2}p;${2}q" "$3"
}
function tls() { # pick a tmux session (most recent first) and attach/switch; ctrl-x kills
  # rows are "<date> <*|space><!|space>\t<name>"; the prefix is fixed-width so names line up
  local list='tmux ls -F "#{session_activity}	#{t/f/%b %d %H#:%M:session_activity} #{?session_attached,*, }#{?#{W:#{P:#{@attn}}},!, }	#{session_name}" | sort -rn | cut -f2-'
  local sel
  sel=$(eval "$list" | fzf --delimiter='\t' --nth=2 --tabstop=1 --no-sort --reverse --height=60% \
      --header='enter: attach  ctrl-x: kill  (* attached, ! needs attention)' \
      --bind="ctrl-x:execute-silent(tmux kill-session -t ={2})+reload:$list" \
      --preview='tmux list-panes -s -t ={2} -F "#{?@attn,⚑ #I.#P #{@attn},}" | grep .; tmux list-panes -s -t ={2} -F "#{pane_current_path}" | sort -u; echo; tmux capture-pane -ep -t ={2}:' \
      --preview-window=right,60%) || return
  sel=${sel#*$'\t'}
  if [[ $TMUX ]]; then tmux switch-client -t "=$sel"; else tmux attach -t "=$sel"; fi
}
function extract() {
    if (( $# == 0 )); then
        echo "Usage: extract FILE... (e.g. extract *.zip)" >&2
        return 1
    fi
    local f status=0
    for f in "$@"; do
        if [[ ! -f "$f" ]]; then
            echo "extract: not a file: $f" >&2
            status=1
            continue
        fi
        case "$f" in
            *.tar.gz|*.tgz)   tar xzf "$f";;
            *.tar.bz2|*.tbz)  tar xjf "$f";;
            *.tar.xz|*.txz)   tar xJf "$f";;
            *.tar)            tar xf "$f";;
            *.zip)            unzip "$f";;
            *.gz)             gunzip "$f";;
            *.bz2)            bunzip2 "$f";;
            *.xz)             unxz "$f";;
            *.7z)             7z x "$f";;
            *)                echo "extract: unknown format: $f" >&2; false;;
        esac || status=$?
    done
    return "$status"
}
# shellcheck disable=SC2155 # local x=$(...): exit statuses aren't checked here
function bkup() {
    local d=false
    [[ "$1" == "-d" ]] && d=true && shift
    local t="${1%/}"
    local s=$($d && date +".%m-%d_%H-%S").bkup
    # TODO verify- bump depth?
    if [ ! -e "$t$s" ]; then
        local old=$(realpath -m "$t")
        mv -iv "$t" "$t$s"
        local new=$(realpath -m "$t$s")
        fd -t l -d 2 . "$(dirname "$old")" | while read -r lnk; do
            local tgt=$(realpath -m "$(dirname "$lnk")/$(readlink "$lnk")")
            [[ "$tgt" == "$old"* ]] && ln -sfn "${new}${tgt#"$old"}" "$lnk"
        done
    else
        echo "$t$s already exists"
    fi
}
function nixos-switch () {
    git -C /etc/nixos add -A
    sudo nixos-rebuild switch \
        --flake /etc/nixos \
        --option warn-dirty false && \
    git -C /etc/nixos commit -m "nixos: $(date '+%Y-%m-%d %H:%M')" && \
    git -C /etc/nixos push
}

